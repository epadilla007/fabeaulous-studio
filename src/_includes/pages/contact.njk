{%- import "partials/macros.njk" as m -%}
{%- set p = t.contact -%}
{%- set f = p.form -%}
{{ m.pageHero(p.hero) }}

<section class="section contact-section" aria-label="{{ p.hero.label }}">
  <div class="container contact-grid">
    <aside class="contact-channels">
      {# PLACEHOLDER: WhatsApp uses site.whatsapp = WHATSAPP_NUMBER until the client confirms the number #}
      <a class="channel channel-wa" href="{{ m.waHref(site, t) }}" target="_blank" rel="noopener" data-whatsapp>
        {{ m.waIcon() }}
        <span><strong>{{ p.channels.waTitle }}</strong><span>{{ p.channels.waBody }}</span></span>
      </a>
      <a class="channel" href="mailto:{{ site.email }}?subject={{ f.subject | urlencode }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z M3 6l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span><strong>{{ p.channels.emailTitle }}</strong><span>{{ site.email }}</span><span>{{ p.channels.emailBody }}</span></span>
      </a>
      <div class="channel channel-static">
        {{ m.disc("channel-disc") }}
        <span><strong>{{ p.channels.baseTitle }}</strong><span>{{ p.channels.baseBody }}</span></span>
      </div>
      <div class="dist-box">
        <h2 class="mini-h">{{ p.dist.title }}</h2>
        <p>{{ p.dist.body }}</p>
      </div>
      <figure class="img-wrap contact-img"><img src="/images/soft-feet-result.jpg" alt="" width="1600" height="1067" loading="lazy" style="object-position: 50% 55%"></figure>
    </aside>

    <div class="form-card" id="pricing">
      <h2 class="section-title">{{ f.title }}</h2>
      <p class="form-intro">{{ f.intro }}</p>
      {# PLACEHOLDER: set site.web3formsKey (YOUR_WEB3FORMS_ACCESS_KEY) in src/_data/site.js #}
      <form class="pricing-form" action="https://api.web3forms.com/submit" method="POST" data-form data-sending="{{ f.sending }}" data-success="{{ f.success }}" data-error="{{ f.error }}">
        <input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
        <input type="hidden" name="subject" value="{{ f.subject }}">
        <input type="hidden" name="from_name" value="Fabeaulous Feet website">
        <input type="hidden" name="language" value="{{ lang }}">
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="field-row">
          <div class="field"><input id="f-name" name="name" type="text" autocomplete="name" required placeholder=" "><label for="f-name">{{ f.name }}</label></div>
          <div class="field"><input id="f-business" name="business" type="text" autocomplete="organization" placeholder=" "><label for="f-business">{{ f.business }}</label></div>
        </div>
        <div class="field-row">
          <div class="field"><input id="f-email" name="email" type="email" autocomplete="email" required placeholder=" "><label for="f-email">{{ f.email }}</label></div>
          <div class="field"><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder=" "><label for="f-phone">{{ f.phone }}</label></div>
        </div>
        <div class="field-row">
          <div class="field field-select">
            <select id="f-country" name="country" required>
              <option value="" selected disabled hidden></option>
              {% for o in f.countryOptions %}<option>{{ o }}</option>{% endfor %}
            </select>
            <label for="f-country">{{ f.country }}</label>
          </div>
          <div class="field field-select">
            <select id="f-role" name="role" required>
              <option value="" selected disabled hidden></option>
              {% for o in f.roleOptions %}<option>{{ o }}</option>{% endfor %}
            </select>
            <label for="f-role">{{ f.role }}</label>
          </div>
        </div>
        <fieldset class="chips">
          <legend>{{ f.interest }}</legend>
          {% for o in f.interestOptions %}
          <label class="chip"><input type="checkbox" name="interest" value="{{ o }}"><span>{{ o }}</span></label>
          {% endfor %}
        </fieldset>
        <div class="field field-area"><textarea id="f-msg" name="message" rows="5" placeholder="{{ f.messagePh }}"></textarea><label for="f-msg">{{ f.message }}</label></div>
        <button class="btn btn-primary btn-block magnetic" type="submit"><span>{{ f.submit }}</span>{{ m.arrow() }}</button>
        <p class="form-status" role="status" aria-live="polite" data-status></p>
        <p class="form-privacy">{{ f.privacy }}</p>
      </form>
    </div>
  </div>
</section>
