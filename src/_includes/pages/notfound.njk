{%- import "partials/macros.njk" as m -%}
<section class="notfound">
  {{ m.disc("nf-disc") }}
  <div class="container nf-grid">
    <div lang="en">
      <p class="section-label">404</p>
      <h1 class="page-title">{{ copy.en.notFound.heading }}</h1>
      <p class="lede">{{ copy.en.notFound.body }}</p>
      <ul class="nf-links">
        <li><a class="btn btn-primary" href="/"><span>Home</span></a></li>
        <li><a class="text-link" href="/products/">{{ copy.en.nav.products }}</a></li>
        <li><a class="text-link" href="/contact/">{{ copy.en.nav.contact }}</a></li>
      </ul>
    </div>
    <div lang="es" class="nf-es">
      <p class="section-label">404</p>
      <h2 class="page-title">{{ copy.es.notFound.heading }}</h2>
      <p class="lede">{{ copy.es.notFound.body }}</p>
      <ul class="nf-links">
        <li><a class="btn btn-outline" href="/es/"><span>Inicio</span></a></li>
        <li><a class="text-link" href="/es/productos/">{{ copy.es.nav.products }}</a></li>
        <li><a class="text-link" href="/es/contacto/">{{ copy.es.nav.contact }}</a></li>
      </ul>
    </div>
  </div>
</section>
