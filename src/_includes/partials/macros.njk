{% macro arrow() %}<svg class="i-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endmacro %}

{% macro waIcon() %}<svg class="i-wa" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>{% endmacro %}

{% macro waHref(site, t) %}https://wa.me/{{ site.whatsapp }}?text={{ t.cta.waText | urlencode }}{% endmacro %}

{# The disc motif: concentric rings + five toe dots #}
{% macro disc(cls="") %}<svg class="disc {{ cls }}" viewBox="0 0 200 200" aria-hidden="true"><circle class="disc-o" cx="100" cy="100" r="96"/><circle class="disc-m" cx="100" cy="100" r="70"/><circle class="disc-i" cx="100" cy="100" r="12"/><g class="disc-dots"><circle cx="100" cy="22" r="5"/><circle cx="121" cy="26" r="4"/><circle cx="138" cy="36" r="3.4"/><circle cx="150" cy="50" r="2.8"/><circle cx="157" cy="65" r="2.2"/></g></svg>{% endmacro %}

{% macro toes() %}<span class="toes" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>{% endmacro %}

{% macro pageHero(h, img="", alt="", pos="center") %}
<section class="page-hero">
  {{ disc("page-hero-disc") }}
  <div class="container page-hero-grid">
    <div class="page-hero-copy">
      <p class="section-label">{{ h.label }}</p>
      <h1 class="page-title fade-up">{{ h.title }}</h1>
      <p class="lede fade-up">{{ h.sub }}</p>
    </div>
    {% if img %}
    <figure class="page-hero-media img-wrap">
      <img src="/images/{{ img }}" alt="{{ alt }}" width="1600" height="1067" style="object-position: {{ pos }}" fetchpriority="high">
    </figure>
    {% endif %}
  </div>
</section>
{% endmacro %}

{% macro ctaBand(t, site, pages, lang, title, body) %}
<section class="cta-band">
  {{ disc("cta-disc") }}
  <div class="container cta-band-inner">
    <div>
      <h2 class="cta-title fade-up">{{ title }}</h2>
      <p class="fade-up">{{ body }}</p>
    </div>
    <div class="cta-actions fade-up">
      <a class="btn btn-light magnetic" href="{{ pages.contact[lang] }}#pricing"><span>{{ t.cta.pricing }}</span>{{ arrow() }}</a>
      {# PLACEHOLDER: WHATSAPP_NUMBER #}
      <a class="btn btn-whatsapp magnetic" href="{{ waHref(site, t) }}" target="_blank" rel="noopener" data-whatsapp>{{ waIcon() }}<span>{{ t.cta.whatsapp }}</span></a>
      <a class="text-link text-link-light" href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
</section>
{% endmacro %}
